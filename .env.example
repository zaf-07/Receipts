# Everything here is optional. With no .env at all, Receipts runs on the seeded demo world
# with deterministic agents and a local credit ledger.

# Port for the API and the built web client.
PORT=8787

# Model-backed agents (Planner, Writer, live-web extraction). Without a key the
# deterministic planner and template writer are used instead.
# ANTHROPIC_API_KEY=
# RECEIPTS_MODEL=claude-opus-5-5
# RECEIPTS_LLM=auto            # auto | off

# Optional Groq provider. When GROQ_API_KEY is present it becomes the default provider.
# GROQ_API_KEY=
# RECEIPTS_LLM_PROVIDER=groq   # groq | anthropic
# RECEIPTS_MODEL=openai/gpt-oss-20b

# Moss semantic retrieval for GET /api/search?q=... . Moss ranks only existing receipts;
# responses are rejoined to local records and source URLs before they leave this API.
# MOSS_PROJECT_ID=
# MOSS_PROJECT_KEY=

# Where signals come from.
#   world = seeded local world of fictional companies (default, works offline)
#   live  = the public web, searched and read through the model (needs ANTHROPIC_API_KEY)
# RECEIPTS_SOURCE=world

# Credits granted on a fresh start. The default leaves the seeded run just short of one
# more enrichment, so the credit gate shows up on its own.
# RECEIPTS_STARTING_CREDITS=38

# The agent team. How many tasks run at once, and how long a worker may hold a task
# without a heartbeat before it is taken back and retried.
# RECEIPTS_CONCURRENCY=4
# RECEIPTS_LEASE_MS=30000

# Flexprice: mirror metered events (enrich, draft, send). The local ledger still gates.
# FLEXPRICE_API_KEY=
# FLEXPRICE_CUSTOMER_ID=
# FLEXPRICE_BASE_URL=https://api.cloud.flexprice.io

# Band: stream specialised Receipts roles and blocked work into a Band room.
# In Band, create a Remote Agent (e.g. "Receipts Orchestrator"), copy its API key,
# then add it to the Room and copy the room ID from its URL/API response.
# BAND_API_KEY=
# BAND_CHAT_ID=
# BAND_API_BASE_URL=https://app.band.ai/api/v1

# Post every agent handoff as JSON to a generic external orchestrator.
# AGENT_EVENTS_WEBHOOK_URL=

# Inbound replies are provider-neutral: POST { message_id, text, source? } to /api/inbound.
# Connect a Resend, SendGrid, or Mailtrap adapter after choosing its webhook-signature scheme.

# Set this if the app is reached at an address other than http://localhost:PORT.
# Receipt source links are built from it.
# PUBLIC_URL=
